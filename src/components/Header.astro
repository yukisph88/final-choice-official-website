---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { href, asset, whatsappLink, telLink } from '../lib/urls';
import { path, LANGS, LANG_LABEL, HTML_LANG, type Lang, type Alternates, type PageKey } from '../i18n/routes';
import { resolveNav } from '../i18n/nav';
import { t } from '../i18n/ui';
interface Props { lang: Lang; currentPath: string; alternates: Alternates; track: 'fw' | 'maid' | 'main' }
const { lang, currentPath, alternates, track } = Astro.props;
const T = t(lang);
const groups = resolveNav(lang, currentPath);
const byId = Object.fromEntries(groups.map((g) => [g.id, g]));

type Item = { label: string; key: PageKey; url: string; active: boolean; sub?: 'fw' | 'maid' };
const items: Item[] = [
  { label: T.nav.home, key: 'home', url: path(lang, 'home'), active: currentPath === path(lang, 'home') },
  { label: T.nav.fw, key: 'fw', url: path(lang, 'fw'), active: track === 'fw', sub: 'fw' },
  { label: T.nav.maid, key: 'maid', url: path(lang, 'maid'), active: track === 'maid', sub: 'maid' },
  { label: T.nav.about, key: 'about', url: path(lang, 'about'), active: currentPath === path(lang, 'about') },
  { label: T.nav.faq, key: 'faq', url: path(lang, 'faq'), active: currentPath === path(lang, 'faq') },
  { label: T.nav.contact, key: 'contact', url: path(lang, 'contact'), active: currentPath === path(lang, 'contact') },
];
const submenuLabel = lang === 'bm' ? 'Submenu' : 'submenu';
// Equivalent page in the other language; if there is no translation, fall back to that language's homepage.
const switchLinks = LANGS.map((l) => ({ l, url: l === lang ? currentPath : alternates[l] ?? path(l, 'home') }));
const waLine = track === 'maid' ? 'maid' : 'fw';
const waMsg = track === 'maid' ? T.wa.maidHome : track === 'fw' ? T.wa.fwHome : T.wa.general;
---
<div class="topstrip">
  <div class="container topstrip__inner">
    <p class="topstrip__lic"><Icon name="shield" size={15} /> {T.strip.licensed}: {site.company.licence}</p>
    <ul class="topstrip__contacts">
      <li><a href={telLink('fw')} data-track="strip_phone_fw"><Icon name="phone" size={15} /> <span class="topstrip__lbl">{T.strip.fw}</span> {site.contact.fw.display}</a></li>
      <li><a href={telLink('maid')} data-track="strip_phone_maid"><Icon name="phone" size={15} /> <span class="topstrip__lbl">{T.strip.maid}</span> {site.contact.maid.display}</a></li>
      <li class="topstrip__mail"><a href={`mailto:${site.company.email}`}><Icon name="mail" size={15} /> {site.company.email}</a></li>
    </ul>
  </div>
</div>
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={href(path(lang, 'home'))} aria-label={`Final Choice — ${T.nav.home}`}>
      <picture>
        <source srcset={asset('images/logo-final-choice-mark.webp')} type="image/webp" />
        <img src={asset('images/logo-final-choice-mark.png')} alt="Agensi Pekerjaan Final Choice logo" width="320" height="196" fetchpriority="high" />
      </picture>
    </a>

    <nav class="main-nav" id="main-nav" aria-label={T.nav.main}>
      <ul>
        {items.map((n) => {
          const g = n.sub ? byId[n.sub] : null;
          if (!g) return <li><a class="nav-link" href={href(n.url)} aria-current={n.active ? 'page' : undefined}>{n.label}</a></li>;
          const sid = `sub-${g.id}`;
          return (
            <li class="nav-item" data-sub>
              <div class="nav-row">
                <a class="nav-link" href={href(n.url)} aria-current={n.active ? 'page' : undefined}>{n.label}</a>
                <button class="sub-toggle" type="button" aria-expanded="false" aria-controls={sid} aria-haspopup="true"><span class="sr-only">{n.label}: {submenuLabel}</span></button>
              </div>
              <div class="subnav" id={sid}>
                <div class="subnav__cols">
                  {g.sections.map((s) => (
                    <div class="subnav__col">
                      <p class="subnav__title">{s.link ? <a href={href(s.link)}>{s.title}</a> : s.title}</p>
                      {s.items.length > 0 && (
                        <ul>
                          {s.items.map((i) => <li><a class="sub-link" href={href(i.href)} aria-current={i.current ? 'page' : undefined}>{i.label}</a></li>)}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
                <a class="subnav__all" href={href(g.all.href)}>{g.all.label} <Icon name="arrow" size={16} /></a>
              </div>
            </li>
          );
        })}
      </ul>
      <a class="btn btn--wa main-nav__cta" href={whatsappLink(waLine, waMsg)} target="_blank" rel="noopener" data-track="whatsapp_header">
        <Icon name="whatsapp" size={18} /> {T.btn.whatsappUs}
      </a>
      <div class="main-nav__foot">
        <a class="btn btn--wa btn--lg" href={whatsappLink('fw', T.wa.fwHome)} target="_blank" rel="noopener" data-track="menu_wa_fw"><Icon name="whatsapp" size={20} /> {T.strip.fw}: {site.contact.fw.display}</a>
        <a class="btn btn--wa btn--lg" href={whatsappLink('maid', T.wa.maidHome)} target="_blank" rel="noopener" data-track="menu_wa_maid"><Icon name="whatsapp" size={20} /> {T.strip.maid}: {site.contact.maid.display}</a>
      </div>
    </nav>

    <div class="lang-switch" role="group" aria-label={T.nav.language}>
      {switchLinks.map(({ l, url }) => (
        l === lang ? (
          <span class="lang-switch__item is-current" aria-current="true" lang={HTML_LANG[l]} title={LANG_LABEL[l].long}>{LANG_LABEL[l].short}</span>
        ) : (
          <a class="lang-switch__item" href={href(url)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} data-set-lang={l} title={T.nav.switchTo} aria-label={`${LANG_LABEL[l].short} – ${LANG_LABEL[l].long}`}>{LANG_LABEL[l].short}</a>
        )
      ))}
    </div>

    <a class="btn btn--wa btn--sm header-wa" href={whatsappLink(waLine, waMsg)} target="_blank" rel="noopener" data-track="whatsapp_header" aria-label={T.btn.whatsappUs}>
      <Icon name="whatsapp" size={18} /> <span>{T.btn.whatsapp}</span>
    </a>
    <button class="nav-toggle" type="button" aria-controls="main-nav" aria-expanded="false" data-nav-toggle>
      <span class="nav-toggle__open"><Icon name="menu" size={24} /></span>
      <span class="nav-toggle__close"><Icon name="close" size={24} /></span>
      <span class="sr-only">{T.nav.menu}</span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const desktop = window.matchMedia('(min-width: 1241px)');
  const subs = [...document.querySelectorAll<HTMLElement>('[data-sub]')];
  const toggleOf = (li: HTMLElement) => li.querySelector<HTMLButtonElement>('.sub-toggle')!;
  const panelOf = (li: HTMLElement) => li.querySelector<HTMLElement>('.subnav')!;
  const setSub = (li: HTMLElement, open: boolean) => {
    li.classList.toggle('is-open', open);
    if (!open) li.classList.remove('is-pinned');
    toggleOf(li).setAttribute('aria-expanded', String(open));
    const panel = panelOf(li);
    panel.style.left = '';
    if (open && desktop.matches) {
      // keep the panel inside the screen
      const over = panel.getBoundingClientRect().right - (window.innerWidth - 16);
      if (over > 0) panel.style.left = `${-over - 12}px`;
    }
  };
  const closeSubs = (except?: HTMLElement) => subs.forEach((li) => { if (li !== except) setSub(li, false); });

  subs.forEach((li) => {
    const toggle = toggleOf(li);
    let timer = 0;
    toggle.addEventListener('click', () => {
      const open = li.classList.contains('is-open');
      if (desktop.matches) {
        // Desktop: hover opens it; a click pins it open (so a click never "undoes" the hover), a second click closes.
        if (open && !li.classList.contains('is-pinned')) { li.classList.add('is-pinned'); return; }
        if (open) { setSub(li, false); return; }
        closeSubs(li); setSub(li, true); li.classList.add('is-pinned'); return;
      }
      closeSubs(li); setSub(li, !open);
    });
    li.addEventListener('mouseenter', () => { if (!desktop.matches) return; window.clearTimeout(timer); closeSubs(li); setSub(li, true); });
    li.addEventListener('mouseleave', () => { if (!desktop.matches || li.classList.contains('is-pinned')) return; timer = window.setTimeout(() => setSub(li, false), 180); });
    li.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && li.classList.contains('is-open')) { setSub(li, false); toggle.focus(); e.stopPropagation(); }
      else if (e.key === 'ArrowDown' && document.activeElement === toggle) { setSub(li, true); panelOf(li).querySelector<HTMLElement>('a')?.focus(); e.preventDefault(); }
    });
    li.addEventListener('focusout', (e) => {
      const to = (e as FocusEvent).relatedTarget as Node | null;
      if (desktop.matches && to && !li.contains(to)) setSub(li, false);
    });
  });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('[data-sub]')) closeSubs(); });

  if (btn && header) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-open', open);
      if (!open) closeSubs();
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && header.classList.contains('is-open')) { set(false); btn.focus(); } });
    header.querySelectorAll('.main-nav a').forEach((a) => a.addEventListener('click', () => set(false)));
    desktop.addEventListener('change', () => { set(false); closeSubs(); });
    // Subtle elevation once the page is scrolled
    const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  // Remember the visitor's explicit language choice (used only by the root address, never for crawlers).
  const currentLang = document.documentElement.lang.startsWith('ms') ? 'bm' : 'en';
  try { localStorage.setItem('fc-lang', currentLang); } catch {}
  document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('fc-lang', a.dataset.setLang!); } catch {} }),
  );
  // Conversion tracking hook: pushes to dataLayer only if analytics is installed later (with consent).
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
    if (!el) return;
    const w = window as unknown as { dataLayer?: object[] };
    w.dataLayer?.push({ event: (el as HTMLAnchorElement).href?.startsWith('tel:') ? 'phone_click' : 'whatsapp_click', label: el.dataset.track, lang: currentLang });
  });
</script>
