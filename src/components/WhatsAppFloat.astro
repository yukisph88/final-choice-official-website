---
import Icon from './Icon.astro';
import { whatsappLink, type Line } from '../lib/urls';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang; line: Line; message: string }
const { lang, line, message } = Astro.props;
const T = t(lang).wa;
---
<a class="wa-float" href={whatsappLink(line, message)} target="_blank" rel="noopener" data-track="whatsapp_float" aria-label={T.float}>
  <Icon name="whatsapp" size={28} />
  <span class="wa-float__label">{T.floatLabel}</span>
</a>
