---
import Icon from './Icon.astro';
import { whatsappLink, telLink, lineInfo, type Line } from '../lib/urls';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
interface Props { lang: Lang; track: 'fw' | 'maid' | 'main'; message?: string; headingId?: string }
const { lang, track, message, headingId } = Astro.props;
const T = t(lang);
const title = track === 'fw' ? T.cta.fwTitle : track === 'maid' ? T.cta.maidTitle : T.cta.generalTitle;
const text = track === 'fw' ? T.cta.fwText : track === 'maid' ? T.cta.maidText : T.cta.generalText;
const lines: Line[] = track === 'main' ? ['fw', 'maid'] : [track];
const msg = (l: Line) => message ?? (l === 'fw' ? T.wa.fwHome : T.wa.maidHome);
const label = (l: Line) => (l === 'fw' ? T.strip.fw : T.strip.maid);
---
<section class="cta-band" aria-labelledby={headingId}>
  <div class="container cta-band__inner">
    <div>
      <h2 id={headingId}>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band__actions">
      {lines.map((l) => (
        <a class="btn btn--wa btn--lg" href={whatsappLink(l, msg(l))} target="_blank" rel="noopener" data-track={`cta_band_${l}`}>
          <Icon name="whatsapp" size={20} /> {track === 'main' ? `WhatsApp: ${label(l)}` : `WhatsApp ${lineInfo(l).display}`}
        </a>
      ))}
      <a class="btn btn--ghost-light btn--lg" href={telLink(lines[0])} data-track="cta_band_call">
        <Icon name="phone" size={18} /> {T.btn.call} {lineInfo(lines[0]).display}
      </a>
    </div>
  </div>
</section>
